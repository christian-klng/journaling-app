# Datenbank (Railway: Referenz auf ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://journal:journal@localhost:54329/journal

# Audio-Speicher (Railway Bucket bzw. lokal Versity Gateway aus docker-compose)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=journal-audio
S3_ACCESS_KEY_ID=journal
S3_SECRET_ACCESS_KEY=journal-secret
# Lokal "true", auf Railway weglassen (virtual-hosted-style)
S3_FORCE_PATH_STYLE=true

# Cortecs AI (https://cortecs.ai)
CORTECS_API_KEY=
CORTECS_BASE_URL=https://api.cortecs.ai/v1
CORTECS_TRANSCRIPTION_MODEL=whisper-large-v3
CORTECS_LLM_MODEL=mistral-small-2603

# Kommagetrennte E-Mail-Adressen, die bei Registrierung/Login Admin-Rechte erhalten
ADMIN_EMAILS=

# Optional: Pfad zu ffmpeg. Ohne Angabe wird das mitgelieferte ffmpeg-static genutzt.
# FFMPEG_BIN=/usr/bin/ffmpeg

# Optional: Sprache der Aufnahmen (ISO-639-1). Leer lassen für automatische Erkennung.
# CORTECS_TRANSCRIPTION_LANGUAGE=de

# Nur lokal: KI-Aufrufe durch Beispieltexte ersetzen (für Entwicklung und Tests ohne API-Key)
# CORTECS_MOCK=true

# Nur lokal: Testkonten für die automatischen Tests (Passwort frei wählen)
# E2E_ADMIN_EMAIL=admin@example.test
# E2E_USER_EMAIL=nutzer@example.test
# E2E_PASSWORD=
