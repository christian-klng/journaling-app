# Datenbank (in Coolify: interne URL der PostgreSQL-Ressource)
DATABASE_URL=postgres://journal:journal@localhost:54329/journal

# Audio-Speicher (Hetzner Object Storage bzw. lokal Versity Gateway aus docker-compose)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=journal-audio
S3_ACCESS_KEY_ID=journal
S3_SECRET_ACCESS_KEY=journal-secret
# Lokal "true", bei Hetzner weglassen (virtual-hosted-style)
S3_FORCE_PATH_STYLE=true

# Cortecs AI (https://cortecs.ai)
CORTECS_API_KEY=
CORTECS_BASE_URL=https://api.cortecs.ai/v1
CORTECS_TRANSCRIPTION_MODEL=whisper-large-v3

# Optional: Pfad zu ffmpeg. Ohne Angabe wird das mitgelieferte ffmpeg-static genutzt.
# FFMPEG_BIN=/usr/bin/ffmpeg

# Optional: Sprache der Aufnahmen (ISO-639-1). Leer lassen für automatische Erkennung.
# CORTECS_TRANSCRIPTION_LANGUAGE=de

# Nur lokal: Transkription durch einen Beispieltext ersetzen (für Entwicklung und Tests ohne API-Key)
# CORTECS_MOCK=true

# Nur lokal: Passwort der Testkonten für die automatischen Tests (frei wählen)
# E2E_PASSWORD=
